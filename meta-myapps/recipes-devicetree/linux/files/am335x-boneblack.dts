&baseboard_eeprom {
	vcc-supply = <&ldo4_reg>;
};

&am33xx_pinmux {
	
    bbb_spi0_pins: pinmux_bbb_spi0_pins {
        pinctrl-single,pins = <
            /* SPI0 */
            AM33XX_PADCONF(AM335X_PIN_SPI0_SCLK, PIN_INPUT_PULLUP, MUX_MODE0)   /* P9_22 (SCL/SCK) */
            AM33XX_PADCONF(AM335X_PIN_SPI0_D0,   PIN_INPUT_PULLUP, MUX_MODE0)   /* P9_21 (MISO) */
            AM33XX_PADCONF(AM335X_PIN_SPI0_D1,   PIN_INPUT_PULLUP, MUX_MODE0)   /* P9_18 (MOSI/SDA) */
            AM33XX_PADCONF(AM335X_PIN_SPI0_CS0,  PIN_INPUT_PULLUP, MUX_MODE0)   /* P9_17 (CS0) */

            /* GPIO control pins */
            AM33XX_PADCONF(AM335X_PIN_GPMC_BEN1, PIN_OUTPUT, MUX_MODE7)         /* DC: P9_12 (GPIO1_28) */
            AM33XX_PADCONF(AM335X_PIN_GPMC_A1,   PIN_OUTPUT, MUX_MODE7)         /* RST: P9_23 (GPIO1_17) */


        >;
    };

	    bbb_can1_pins: pinmux_bbb_can1_pins {
        pinctrl-single,pins = <
			/* GPIO can */
            AM33XX_PADCONF(AM335X_PIN_UART1_TXD, PIN_INPUT, MUX_MODE2)         /* P9_24 CAN 1 RX*/
            AM33XX_PADCONF(AM335X_PIN_UART1_RXD,   PIN_OUTPUT, MUX_MODE2)      /* P9_26 CAN 1 TX */
        >;
    };

	 pru0_enc_pwm_pins: pinmux_pru0_enc_pwm_pins {
        pinctrl-single,pins = <

            /* Encoder 0: A/B (input) */
            AM33XX_PADCONF(AM335X_PIN_GPMC_AD12, PIN_INPUT, MUX_MODE6)   /* P8_12 -> pr1_pru0_pru_r31_12 */
            AM33XX_PADCONF(AM335X_PIN_GPMC_AD13, PIN_INPUT, MUX_MODE6)   /* P8_11 -> pr1_pru0_pru_r31_13 */

            /* Encoder 1: A/B (input) */
            AM33XX_PADCONF(AM335X_PIN_GPMC_AD14, PIN_INPUT, MUX_MODE6)   /* P8_16 -> pr1_pru0_pru_r31_14 */
            AM33XX_PADCONF(AM335X_PIN_GPMC_AD15, PIN_INPUT, MUX_MODE6)   /* P8_15 -> pr1_pru0_pru_r31_15 */
			/* plush pwm */
            AM33XX_PADCONF(AM335X_PIN_LCD_VSYNC, PIN_OUTPUT, MUX_MODE5)  /* P9_27 -> pr1_pru0_pru_r30_0 */
        >;
    };


};

&dcan1{
	status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&bbb_can1_pins>;

};

&spi0 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&bbb_spi0_pins>;

    st7789v@0 {
        reg = <0>;
        compatible = "sitronix,st7789v";
        width = <240>;
        height = <240>;
		buswidth = <8>;

        dc-gpios = <&gpio1 28 GPIO_ACTIVE_HIGH>;   /* DC pin: P9_12 */
        reset-gpios = <&gpio1 17 GPIO_ACTIVE_LOW>; /* RST pin: P9_23 */
    };
};

&pruss_tm {
    status = "okay";
};

&pruss {
    status = "okay";
};

&pru0 {
    status = "okay";
    firmware-name = "am335x-pru0-fw";   

};

&pru1 {
    status = "disabled";

};


&lcdc {
    status = "disabled";
};