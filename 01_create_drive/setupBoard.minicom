timeout 301
verbose on
expect {
    "Press SPACE to abort autoboot in 0 seconds"
}
send " "
expect {
    "=>"
}
send "setenv ipaddr 192.168.8.8"

expect {
    "=>"
}
send "setenv serverip 192.168.8.9"

expect {
    "=>"
}
send "setenv netmask 255.255.255.0"

expect {
    "=>"
}
send "setenv gatewayip 192.168.8.1"

expect {
    "=>"
}
send setenv rootpath '/home/huy/work_space/ti_sdk_board/targetNFS'

expect {
    "=>"
}
send "setenv bootfile zImage-am335x-evm.bin"

expect {
    "=>"
}
send "setenv bootargs 'console=ttyO0,115200n8 root=/dev/nfs nfsroot=192.168.8.9:/home/huy/work_space/ti_sdk_board/targetNFS,nolock,v3,tcp,rsize=4096,wsize=4096 rw ip=192.168.8.8:192.168.8.9:192.168.8.1:255.255.255.0::eth0'"
expect {
    "=>"
}
send "setenv nfsopts 'nolock,v3,tcp,rsize=4096,wsize=4096'"

expect {
    "=>"
}
send setenv bootcmd 'run findfdt; run init_console; setenv autoload no;tftp ${loadaddr} zImage-am335x-evm.bin; tftp ${fdtaddr} ${fdtfile}; bootz ${loadaddr} - ${fdtaddr}'
expect {
    "=>"
}
send "boot"


